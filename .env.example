DB_HOST=localhost
DB_PORT=5432
DB_NAME=daleel
DB_USER=daleel_app
DB_PASSWORD='REPLACE_WITH_YOUR_DATABASE_PASSWORD'
DALEEL_API_TOKEN=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_TOKEN
DALEEL_HOST=127.0.0.1
DALEEL_PORT=5000

# Local default. For hosting set production and supply the settings below.
DALEEL_ENV=development
# DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@HOST:5432/daleel
# DB_SSLMODE=verify-full
# DALEEL_COOKIE_SECURE=1
# DALEEL_ALLOWED_HOSTS=daleel.example.com
# PORT=5000
# DALEEL_HOST=0.0.0.0
# Configure only for an actual trusted reverse proxy; see README.
# DALEEL_TRUSTED_PROXY=127.0.0.1
# DALEEL_PROXY_COUNT=1
