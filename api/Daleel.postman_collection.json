{
  "info": {
    "name": "Daleel backend handoff",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "api_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Models and limits",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/v1/models"
      }
    },
    {
      "name": "Predict transactions",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/v1/transactions/predict",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transactions\": [\n    {\n      \"record_id\": \"example-normal\",\n      \"step\": 10,\n      \"type\": \"PAYMENT\",\n      \"amount\": 100.0,\n      \"oldbalanceOrg\": 500.0,\n      \"newbalanceOrig\": 400.0,\n      \"oldbalanceDest\": 0.0,\n      \"newbalanceDest\": 0.0\n    },\n    {\n      \"record_id\": \"example-review\",\n      \"step\": 11,\n      \"type\": \"TRANSFER\",\n      \"amount\": 10000.0,\n      \"oldbalanceOrg\": 10000.0,\n      \"newbalanceOrig\": 0.0,\n      \"oldbalanceDest\": 500.0,\n      \"newbalanceDest\": 500.0\n    },\n    {\n      \"record_id\": \"example-unseen\",\n      \"step\": 12,\n      \"type\": \"NEW_TRANSACTION_TYPE\",\n      \"amount\": 125.0,\n      \"oldbalanceOrg\": 1000.0,\n      \"newbalanceOrig\": 875.0,\n      \"oldbalanceDest\": 250.0,\n      \"newbalanceDest\": 375.0\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
