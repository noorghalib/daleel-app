{
  "openapi": "3.1.0",
  "info": {
    "title": "Daleel ML internal inference API",
    "version": "1.0.0",
    "description": "10 MiB body limit; Bearer service token. Transactions must be completed. Ledger score is not fraud probability."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000"
    }
  ],
  "security": [
    {
      "ServiceToken": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Models loaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "models",
        "responses": {
          "200": {
            "description": "Model identities and limits",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid service token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/transactions/predict": {
      "post": {
        "operationId": "predictTransactions",
        "description": "Synchronous bounded inference. No persistence. See Arabic backend guide for batching and score semantics.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransactionsRequest"
              },
              "example": {
                "transactions": [
                  {
                    "record_id": "example-normal",
                    "step": 10,
                    "type": "PAYMENT",
                    "amount": 100.0,
                    "oldbalanceOrg": 500.0,
                    "newbalanceOrig": 400.0,
                    "oldbalanceDest": 0.0,
                    "newbalanceDest": 0.0
                  },
                  {
                    "record_id": "example-review",
                    "step": 11,
                    "type": "TRANSFER",
                    "amount": 10000.0,
                    "oldbalanceOrg": 10000.0,
                    "newbalanceOrig": 0.0,
                    "oldbalanceDest": 500.0,
                    "newbalanceDest": 500.0
                  },
                  {
                    "record_id": "example-unseen",
                    "step": 12,
                    "type": "NEW_TRANSACTION_TYPE",
                    "amount": 125.0,
                    "oldbalanceOrg": 1000.0,
                    "newbalanceOrig": 875.0,
                    "oldbalanceDest": 250.0,
                    "newbalanceDest": 375.0
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Predictions in input order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid service token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body or row limit exceeded; proxy may return plain text",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON Content-Type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid fields/types/relationships",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Busy; retry with backoff",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ledger/predict": {
      "post": {
        "operationId": "predictLedger",
        "description": "Synchronous bounded inference. No persistence. See Arabic backend guide for batching and score semantics.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LedgerRequest"
              },
              "example": {
                "sector": "energy",
                "review_fraction": 0.01,
                "headers": [
                  {
                    "document_id": "demo-001",
                    "posting_date": "2025-01-01",
                    "document_date": "2025-01-01",
                    "document_type": "SA",
                    "source": "manual",
                    "business_process": "O2C"
                  },
                  {
                    "document_id": "demo-002",
                    "posting_date": "2025-01-02",
                    "document_date": "2025-01-02",
                    "document_type": "KR",
                    "source": "manual",
                    "business_process": "P2P"
                  },
                  {
                    "document_id": "demo-003",
                    "posting_date": "2025-01-03",
                    "document_date": "2025-01-01",
                    "document_type": "SA",
                    "source": "manual",
                    "business_process": "O2C"
                  }
                ],
                "lines": [
                  {
                    "document_id": "demo-001",
                    "line_number": 1,
                    "gl_account": "411000",
                    "debit_amount": 100.0,
                    "credit_amount": 0.0,
                    "local_amount": 100.0,
                    "auxiliary_account_number": "C-DEMO"
                  },
                  {
                    "document_id": "demo-001",
                    "line_number": 2,
                    "gl_account": "701000",
                    "debit_amount": 0.0,
                    "credit_amount": 100.0,
                    "local_amount": -100.0,
                    "auxiliary_account_number": "C-DEMO"
                  },
                  {
                    "document_id": "demo-002",
                    "line_number": 1,
                    "gl_account": "601000",
                    "debit_amount": 200.0,
                    "credit_amount": 0.0,
                    "local_amount": 200.0,
                    "auxiliary_account_number": "V-DEMO"
                  },
                  {
                    "document_id": "demo-002",
                    "line_number": 2,
                    "gl_account": "401000",
                    "debit_amount": 0.0,
                    "credit_amount": 200.0,
                    "local_amount": -200.0,
                    "auxiliary_account_number": "V-DEMO"
                  },
                  {
                    "document_id": "demo-003",
                    "line_number": 1,
                    "gl_account": "411000",
                    "debit_amount": 900.0,
                    "credit_amount": 0.0,
                    "local_amount": 900.0,
                    "auxiliary_account_number": "C-DEMO"
                  },
                  {
                    "document_id": "demo-003",
                    "line_number": 2,
                    "gl_account": "701000",
                    "debit_amount": 0.0,
                    "credit_amount": 800.0,
                    "local_amount": -800.0,
                    "auxiliary_account_number": "C-DEMO"
                  }
                ],
                "chart_of_accounts": [
                  {
                    "account_number": "411000",
                    "account_type": "Tiers"
                  },
                  {
                    "account_number": "701000",
                    "account_type": "Revenue"
                  },
                  {
                    "account_number": "601000",
                    "account_type": "Expense"
                  },
                  {
                    "account_number": "401000",
                    "account_type": "Tiers"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Predictions in input order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid service token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body or row limit exceeded; proxy may return plain text",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON Content-Type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid fields/types/relationships",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Busy; retry with backoff",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ServiceToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Transaction": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "step": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000.0
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -1000000000000000.0,
            "maximum": 1000000000000000.0
          },
          "oldbalanceOrg": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -1000000000000000.0,
            "maximum": 1000000000000000.0
          },
          "newbalanceOrig": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -1000000000000000.0,
            "maximum": 1000000000000000.0
          },
          "oldbalanceDest": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -1000000000000000.0,
            "maximum": 1000000000000000.0
          },
          "newbalanceDest": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -1000000000000000.0,
            "maximum": 1000000000000000.0
          }
        },
        "required": [
          "record_id",
          "step",
          "type",
          "amount",
          "oldbalanceOrg",
          "newbalanceOrig",
          "oldbalanceDest",
          "newbalanceDest"
        ],
        "additionalProperties": false
      },
      "LedgerHeader": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "posting_date": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "document_date": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "document_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "business_process": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        },
        "required": [
          "document_id",
          "posting_date",
          "document_date",
          "document_type",
          "source",
          "business_process"
        ],
        "additionalProperties": false
      },
      "LedgerLine": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "line_number": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000.0
          },
          "gl_account": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "debit_amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -1000000000000000.0,
            "maximum": 1000000000000000.0
          },
          "credit_amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -1000000000000000.0,
            "maximum": 1000000000000000.0
          },
          "local_amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -1000000000000000.0,
            "maximum": 1000000000000000.0
          },
          "auxiliary_account_number": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        },
        "required": [
          "document_id",
          "line_number",
          "gl_account",
          "debit_amount",
          "credit_amount",
          "local_amount",
          "auxiliary_account_number"
        ],
        "additionalProperties": false
      },
      "Account": {
        "type": "object",
        "properties": {
          "account_number": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "account_type": {
            "type": "string",
            "enum": [
              "Asset",
              "Liability",
              "Equity",
              "Tiers",
              "Expense",
              "Revenue",
              "Special"
            ]
          }
        },
        "required": [
          "account_number",
          "account_type"
        ],
        "additionalProperties": false
      },
      "TransactionsRequest": {
        "type": "object",
        "properties": {
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transaction"
            },
            "minItems": 1,
            "maxItems": 10000
          }
        },
        "required": [
          "transactions"
        ],
        "additionalProperties": false
      },
      "LedgerRequest": {
        "type": "object",
        "properties": {
          "sector": {
            "type": "string",
            "enum": [
              "energy",
              "healthcare",
              "luxurygoods",
              "manufacturing",
              "transport"
            ]
          },
          "headers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LedgerHeader"
            },
            "minItems": 1,
            "maxItems": 1000
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LedgerLine"
            },
            "minItems": 0,
            "maxItems": 10000
          },
          "chart_of_accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Account"
            },
            "minItems": 0,
            "maxItems": 10000
          },
          "review_fraction": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "maximum": 1,
            "default": 0.01,
            "description": "Omitted: top ceil(N*0.01) in this request. Null: fixed saved validation threshold."
          }
        },
        "required": [
          "sector",
          "headers",
          "lines",
          "chart_of_accounts"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "request_id",
          "error"
        ],
        "additionalProperties": false
      },
      "TransactionPrediction": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string"
          },
          "prediction": {
            "type": "string",
            "enum": [
              "Normal",
              "Anomaly"
            ]
          },
          "fraud_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rule_alert": {
            "type": "boolean"
          },
          "rule_reasons": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "record_id",
          "prediction",
          "fraud_score",
          "rule_alert",
          "rule_reasons",
          "reason"
        ],
        "additionalProperties": false
      },
      "LedgerPrediction": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string"
          },
          "sector": {
            "type": "string",
            "enum": [
              "energy",
              "healthcare",
              "luxurygoods",
              "manufacturing",
              "transport"
            ]
          },
          "anomaly_score": {
            "type": "number"
          },
          "review_alert": {
            "type": "boolean"
          },
          "rule_alert": {
            "type": "boolean"
          },
          "rule_reasons": {
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "sector",
          "anomaly_score",
          "review_alert",
          "rule_alert",
          "rule_reasons"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "const": "ready"
          },
          "api_version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "api_version"
        ],
        "additionalProperties": false
      },
      "TransactionsResponse": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "api_version": {
            "type": "string"
          },
          "model_id": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "elapsed_ms": {
            "type": "number",
            "minimum": 0
          },
          "predictions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionPrediction"
            }
          }
        },
        "required": [
          "request_id",
          "api_version",
          "model_id",
          "count",
          "elapsed_ms",
          "predictions"
        ],
        "additionalProperties": false
      },
      "LedgerResponse": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "api_version": {
            "type": "string"
          },
          "model_id": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "elapsed_ms": {
            "type": "number",
            "minimum": 0
          },
          "predictions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LedgerPrediction"
            }
          },
          "review_policy": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "fixed_validation_threshold",
                  "batch_top_fraction"
                ]
              },
              "review_fraction": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0,
                "maximum": 1,
                "default": 0.01,
                "description": "Omitted: top ceil(N*0.01) in this request. Null: fixed saved validation threshold."
              }
            },
            "required": [
              "mode",
              "review_fraction"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "request_id",
          "api_version",
          "model_id",
          "count",
          "elapsed_ms",
          "predictions",
          "review_policy"
        ],
        "additionalProperties": false
      },
      "ModelsResponse": {
        "type": "object",
        "properties": {
          "api_version": {
            "type": "string"
          },
          "identity": {
            "type": "object"
          },
          "limits": {
            "type": "object"
          },
          "sectors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ledger_default_review_fraction": {
            "type": "number"
          }
        },
        "required": [
          "api_version",
          "identity",
          "limits",
          "sectors",
          "ledger_default_review_fraction"
        ],
        "additionalProperties": false
      }
    }
  }
}
